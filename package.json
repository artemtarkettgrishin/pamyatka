{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "10.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-backend.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:backend": "node scripts/build-backend.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-backend.mjs && node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:visual": "node tests/visual.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.47.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "playwright": "1.51.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "esbuild": "0.27.7"
  }
}
